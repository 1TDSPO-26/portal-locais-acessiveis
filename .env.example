# Endereço da API. Este valor poderá aparecer no navegador.
# Em desenvolvimento NÃO é preciso definir: o front usa "/api" e o Vite
# repassa para o JSON Server (npm run api), conforme o proxy em vite.config.ts.
# Defina apenas para usar outra API, por exemplo em produção:
# VITE_API_URL=https://api.exemplo.com

# Nunca coloque neste arquivo senhas, tokens privados ou credenciais de e-mail.
# Segredos devem permanecer no servidor ou no serviço responsável pela API.

